{
  "manifest_version": 3,
  "name": "TaskM",
  "version": "1.0.0",
  "description": "Send the school page you're looking at, like a class OneNote or Teams post, to TaskM so it can find your homework.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Send this page to TaskM",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://taskm-school.web.app/*",
    "https://*.sharepoint.com/*",
    "https://*.officeapps.live.com/*",
    "https://*.onenote.com/*",
    "https://*.onenote.officeapps.live.com/*",
    "https://teams.microsoft.com/*",
    "https://*.office.com/*"
  ],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+T" }, "description": "Send this page to TaskM" }
  }
}
